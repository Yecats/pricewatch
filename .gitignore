# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
# local-* is too broad — it matches local-db.ts which we need.
# Only ignore local env files instead.
local.env
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Don't commit the generated source ZIP (built artifact)
public/*.zip

# Skills directory
/skills/