// Production schema — PostgreSQL
// This is a mirror of prisma/schema.prisma but with the provider swapped to postgresql.
// Used when DATABASE_URL points to a Postgres instance.
//
// Why two schemas? Prisma requires the provider to be hardcoded at build time,
// not derived from env. We keep schema.prisma (SQLite) for local dev and
// schema.prod.prisma (Postgres) for production. The deploy script copies this
// file to schema.prisma before running prisma generate/db:push on the server.
//
// See deploy/swap-schema.sh

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#8b5cf6")
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  prices PriceEntry[]
}

// Product is a COMPARISON GROUP — e.g. "Mac & Cheese" groups together
// Kraft dinner cups, Kraft 18-pack, store brand, etc.
// Brand, barcode, and imageUrl live on PriceEntry (the variant), not here.
model Product {
  id        String   @id @default(cuid())
  name      String
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  prices        PriceEntry[]
  shoppingItems ShoppingListItem[]
}

model PriceEntry {
  id            String    @id @default(cuid())
  productId     String
  storeId       String
  price         Float
  quantity      Float     @default(1)
  sizeValue     Float     @default(1)
  sizeUnit      String    @default("count")
  brand         String?
  imageUrl      String?
  notes         String?
  isSale        Boolean   @default(false)
  saleExpiresAt DateTime?
  isOnline      Boolean   @default(false)
  barcode       String?
  dateChecked   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([barcode])
}

model ShoppingListItem {
  id        String   @id @default(cuid())
  productId String
  quantity  Float    @default(1)
  notes     String?
  purchased Boolean  @default(false)
  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([purchased])
}
