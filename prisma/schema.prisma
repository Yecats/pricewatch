// Price tracker — local SQLite (dev) / PostgreSQL (prod)
// See prisma/schema.prod.prisma for the production variant.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#8b5cf6")
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // soft delete for sync — null = active

  prices PriceEntry[]
}

// Product is a COMPARISON GROUP — e.g. "Mac & Cheese" groups together
// Kraft dinner cups, Kraft 18-pack, store brand, etc.
// Brand, barcode, and imageUrl live on PriceEntry (the variant), not here.
model Product {
  id        String   @id @default(cuid())
  name      String   // group name, e.g. "Mac & Cheese"
  category  String?
  notes     String?  // group-level notes (e.g. "Family favorite")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?  // soft delete for sync — null = active

  prices        PriceEntry[]
  shoppingItems ShoppingListItem[]
}

model PriceEntry {
  id           String   @id @default(cuid())
  productId    String
  storeId      String
  price        Float
  quantity     Float    @default(1) // e.g. 18 boxes
  sizeValue    Float    @default(1) // e.g. 7.5
  sizeUnit     String   @default("count") // oz, lb, g, kg, ml, L, fl_oz, gal, count, each
  brand        String?  // brand of THIS specific variant (e.g. "Kraft")
  imageUrl     String?  // product image for this variant (from OpenFoodFacts)
  notes        String?  // variant-specific notes (e.g. "Dinner cups", "Club pack")
  isSale       Boolean  @default(false)
  saleExpiresAt DateTime?
  isOnline     Boolean  @default(false)  // true = bought online (Amazon, manufacturer, etc.)
  barcode      String?  // barcode of this specific variant
  dateChecked  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?  // soft delete for sync — null = active

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([barcode])
}

model ShoppingListItem {
  id          String   @id @default(cuid())
  productId   String
  quantity    Float    @default(1)
  notes       String?
  purchased   Boolean  @default(false)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?  // soft delete for sync — null = active

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([purchased])
}
