// Price tracker — local SQLite (dev) / PostgreSQL (prod)
// Three-layer model: Groups → Products → Prices
//
// Groups are comparison collections (e.g. "Mac & Cheese").
// Products are physical items with barcodes/brands (e.g. "Kraft 18-pack").
// Prices are per-store entries on a product (e.g. "Costco $24.99").
// Products can belong to multiple groups (many-to-many via GroupProduct).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#8b5cf6")
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  prices PriceEntry[]
}

// A comparison group — e.g. "Mac & Cheese", "Chicken", "Quick Dinners"
model ProductGroup {
  id        String   @id @default(cuid())
  name      String
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  products GroupProduct[]
  shoppingItems ShoppingListItem[]
}

// Junction table — many-to-many between Groups and Products
model GroupProduct {
  id        String   @id @default(cuid())
  groupId   String
  productId String
  createdAt DateTime @default(now())

  group   ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([groupId, productId])
  @@index([groupId])
  @@index([productId])
}

// A physical product with a barcode — e.g. "Kraft Mac & Cheese 18-pack"
model Product {
  id        String   @id @default(cuid())
  name      String
  brand     String?
  barcode   String?
  imageUrl  String?
  category  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  prices  PriceEntry[]
  groups  GroupProduct[]

  @@index([barcode])
}

// A price entry at a specific store for a specific product
model PriceEntry {
  id           String   @id @default(cuid())
  productId    String
  storeId      String
  price        Float
  quantity     Float    @default(1)
  sizeValue    Float    @default(1)
  sizeUnit     String   @default("count")
  notes        String?
  isSale       Boolean  @default(false)
  saleExpiresAt DateTime?
  isOnline     Boolean  @default(false)
  dateChecked  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
}

model ShoppingListItem {
  id          String   @id @default(cuid())
  groupId     String
  quantity    Float    @default(1)
  notes       String?
  purchased   Boolean  @default(false)
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  group ProductGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([purchased])
}
